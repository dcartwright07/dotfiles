alias v="nvim"
alias edit="v ~/.zshrc"                                        # local secrets zshrc
alias edit-shared="cd ~/Repos/dotfiles/mac; v zshrc"  # shared committed config
alias refresh="source ~/.zshrc"
alias nv-config="cd ~/.config/nvim/lua/user/; v"
alias ghostty-config="cd ~/Library/Application Support/com.mitchellh.ghostty; v config"
alias kitty-config="cd ~/.config/kitty/; v"
alias kitty-fonts="kitty +list-fonts --psnames"
alias ssh='TERM=xterm-256color ssh'
alias man="batman"
alias p="pnpm"
alias pw="npx playwright"
alias weather="curl wttr.in"

alias hosts="sudo nvim /etc/hosts"
alias editKeys="nvim ~/.ssh/known_hosts"
alias listen="lsof -nP | grep LISTEN"
alias listByDate="find ${1} -type f | xargs stat --format '%Y :%y %n' 2>/dev/null | sort -nr | cut -d: -f2-"
alias password="security find-generic-password"
alias cpass="op items list | fzf | awk '{print \$1}' | xargs -I % sh -c 'op item get % --fields label=password' | pbcopy"
alias fpass="op items list | fzf | awk '{print \$1}' | xargs -I % sh -c 'op item get % --fields label=password'"
alias spass="op items list | fzf | awk '{print \$1}' | xargs -I % sh -c 'op item get %'"

alias d-view="lazydocker"
alias d="docker"

# Laravel Projects
alias sail="[ -f sail ] && sh sail || sh vendor/bin/sail"
alias s-up="sail up -d"
alias s-dn="sail down"
alias art="sail artisan"
alias routes="sail artisan route:list --except-vendor"

# Github
alias bugs="gh issue list -l bug"
alias my-issues="gh issue list -a @me"
alias issues="gh issue list"
alias feats="gh issue list -l enhancement"
alias prs="gh pr list"
alias gh-squash="gh pr list | fzf | awk '{print \$1}' | xargs -I % sh -c 'gh pr merge % -d --squash'; ggpull"

# Git
alias g-undo="git reset --soft HEAD~1"

# Tools
alias sys="tiptop"
alias f="fzf --preview 'bat --color=always {}'"
alias lg="lazygit"
alias ls="lsd"
alias j="fjira"
alias count="wc"
alias cd="z"

alias pip="python3 -m pip"

alias tmux-config="v ~/.config/tmux/tmux.conf"
alias neovide-config="v $HOME/.config/neovide/config.toml"

alias ip-p="curl ifconfig.me"
alias ip="ifconfig en0 | grep inet"

# Laravel Projects
alias sphp="brew unlink php@${1} && brew link php@${2}"

# Tools
alias load="tmuxp load"
alias browser-mcp="npx @agentdeskai/browser-tools-server@1.2.0"

# Agent OS
alias agent-install="~/Repos/dotfiles/agent-os/.agent-os/setup/project.sh"
alias agent-custom="nvim ~/Repos/dotfiles/agent-os/.agent-os/standards/"
alias agent-config="nvim ~/Repos/dotfiles/agent-os/.agent-os/config.yml"

# Ollama
alias qwen3="ANTHROPIC_AUTH_TOKEN=ollama ANTHROPIC_BASE_URL=http://localhost:11434 ANTHROPIC_API_KEY="" claude --model qwen3-coder-next"
alias minimax="ANTHROPIC_AUTH_TOKEN=ollama ANTHROPIC_BASE_URL=http://localhost:11434 ANTHROPIC_API_KEY="" claude --model minimax-m2.7:cloud"

# Claude
alias agents="claude agents"
