source ~/Repos/dotfiles/os/shared/.zshrc_aliases

# alias ztheme="v ~/.config/.oh-my-zsh/themes/dominic.zsh-theme"
alias tmux-config="v ~/.config/tmux/tmux.conf"
alias neovide-config="v $HOME/.config/neovide/config.toml"

alias ip-p="curl ifconfig.me"
alias ip="ifconfig en0 | grep inet"

# Laravel Projects
alias sail="[ -f sail ] && sh sail || sh vendor/bin/sail"
alias sphp="brew unlink php@${1} && brew link php@${2}"

# Tools
alias load="tmuxp load"
alias browser-mcp="npx @agentdeskai/browser-tools-server@1.2.0"

# Agent OS
alias agent-install="nvim ~/Repos/dotfiles/agent-os/.agent-os/setup/project.sh"
alias agent-custom="nvim ~/Repos/dotfiles/agent-os/.agent-os/standards/"
alias agent-config="nvim ~/Repos/dotfiles/agent-os/.agent-os/config.yml"
